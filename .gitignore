# Root-level ignores for the whole monorepo. backend/ and frontend/ each have
# their own more specific .gitignore.

# Compose-level env (Postgres credentials, host ports) — see .env.example.
.env
.env.*
!.env.example

# OS / editor cruft that can show up at the repo root regardless of subproject.
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/

# Local AI-assistant state and personal scratch notes — not part of the project.
.claude/
resume-claude.txt
answer.md
