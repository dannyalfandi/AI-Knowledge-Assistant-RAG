# Read by `docker compose` itself (Compose auto-loads a `.env` next to
# docker-compose.yml) to fill in the ${...} placeholders in that file.
# Per-service application config still lives in backend/.env — see
# backend/.env.example. Copy this file to `.env` and fill it in; `.env` is
# gitignored, never commit real credentials.

POSTGRES_DB=knowledge_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Host port Postgres is published on (container always listens on 5432
# internally regardless of this value).
POSTGRES_PORT=5432

# Host port the backend is published on.
BACKEND_PORT=3000

# Host port Nginx (serving the Flutter web build + reverse-proxying /api) is
# published on.
WEB_PORT=8080
