PORT=

DATABASE_URL=

JWT_SECRET=
JWT_EXPIRES_IN=

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_USER_NAME=

# Required when EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=

# Required when LLM_PROVIDER=groq
GROQ_API_KEY=

# Required when EMBEDDING_PROVIDER=huggingface or LLM_PROVIDER=huggingface
HF_TOKEN=

# huggingface | openai (default: huggingface)
EMBEDDING_PROVIDER=huggingface
# Default: intfloat/multilingual-e5-small (multilingual, HF). Other options:
# text-embedding-3-small (OpenAI). E5 models automatically get "query: " /
# "passage: " prefixes; see services/ai/embedding/embedding-model-config.ts.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Must match the model's output size (default: 384 for e5-small, 1536 for text-embedding-3-small)
EMBEDDING_DIMENSIONS=384

# groq | huggingface (default: groq)
LLM_PROVIDER=groq
# Model name for the selected LLM provider. Check GET /v1/models — model
# availability depends on the API key.
# groq default: openai/gpt-oss-120b
# huggingface example: meta-llama/Llama-3.1-8B-Instruct
LLM_MODEL=openai/gpt-oss-120b